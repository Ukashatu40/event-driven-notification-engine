    "/api/v1/users/{userId}/consents": {
      "post": {
        "operationId": "ConsentController_record",
        "summary": "Record a consent event (opt-in or opt-out)",
        "description": "Append-only. `granted` is derived from `consent_type`. WhatsApp requires WHATSAPP_OPT_IN / WHATSAPP_OPT_OUT. Send the end user's `ip_address` and `user_agent`.",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordConsentBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Consent event recorded"
          },
          "404": {
            "description": "User not found"
          },
          "422": {
            "description": "Invalid consent event"
          }
        },
        "tags": [
          "compliance"
        ],
        "security": [
          {
            "JWT": []
          }
        ]
      },
      "get": {
        "operationId": "ConsentController_history",
        "summary": "Full consent history for a user (newest first)",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "channel",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "sms",
                "email",
                "push",
                "whatsapp",
                "in_app"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "compliance"
        ],
        "security": [
          {
            "JWT": []
          }
