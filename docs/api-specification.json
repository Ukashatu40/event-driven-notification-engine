    "/api/v1/compliance/audit/sms": {
      "get": {
        "operationId": "ComplianceAuditController_sms",
        "summary": "SMS audit trail with proof that DND was checked before each send",
        "description": "Challenge B2.3. Window defaults to the last 90 days (maximum 90). `summary.sent_without_dnd_check` must be 0.",
        "parameters": [
          {
            "name": "page",
