# App
NODE_ENV=development
PORT=3000
APP_NAME=WealthBridge

# JWT
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRY=1h
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars
JWT_REFRESH_EXPIRY=7d

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notification_engine
DB_USER=notification_user
DB_PASSWORD=change-me
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-engine
KAFKA_GROUP_ID_STANDARD=notification-standard-cg
KAFKA_GROUP_ID_CRITICAL=notification-critical-cg

# RabbitMQ
RABBITMQ_URL=amqp://notification_user:change-me@localhost:5672
RABBITMQ_EXCHANGE=notifications
RABBITMQ_DLX=notifications.dlx

# SMS — MSG91
MSG91_API_KEY=
MSG91_SENDER_ID=WLTHBR
MSG91_TEMPLATE_ID=

# SMS — Twilio (fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@wealthbridge.in

# FCM Push
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# WhatsApp
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Security
WEBHOOK_SIGNATURE_SECRET=change-me
CORS_ORIGINS=http://localhost:3000

# Feature flags
ENABLE_AB_TESTING=true
ENABLE_SEND_TIME_OPTIMIZATION=true
ENABLE_WEBSOCKET_DASHBOARD=true

# One key per role. A role with an empty key cannot log in.
SERVICE_API_KEY=
OPERATOR_API_KEY=
ADMIN_API_KEY=

# PII protection — generate each with: openssl rand -hex 32
PII_ENCRYPTION_KEY=
PII_HASH_KEY=

# Nigeria — SMS (Termii) and inbound-payment webhooks. All optional.
# Without TERMII_API_KEY the provider simulates sends. A payment webhook whose
# secret is empty rejects every request.
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
OPAY_SECRET_KEY=
INTERSWITCH_SECRET_KEY=

# Consent enforcement at dispatch: enforce (default) | audit (allow + log, for migrating users) | off
CONSENT_ENFORCEMENT=enforce

# TLS to Kafka: true for a TLS broker, false for the plaintext docker-compose broker
KAFKA_SSL=false
