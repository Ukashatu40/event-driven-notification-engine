# .env.cloud.example
#
# The free-cloud deployment topology (see DEPLOYMENT-CLOUD.md): Postgres on
# Neon, Redis + Kafka on Upstash, RabbitMQ on CloudAMQP, the app on Render.
# Everything NOT in this file (SMTP, PII keys, JWT secrets, role API keys,
# provider keys, CORS_ORIGINS, CONSENT_ENFORCEMENT, ...) is unchanged from
# .env.example — paste those in as normal. This file only covers what's
# DIFFERENT when the infra is managed/cloud instead of the bundled containers.
#
# Paste the resulting values into Render's dashboard → your service →
# Environment. Never commit a filled-in copy of this file.

# App — Render sets PORT itself; NODE_ENV should be production.
NODE_ENV=production

# Postgres — Neon dashboard → your project → Connection Details → "Pooled
# connection", which already includes ?sslmode=require. Paste it whole.
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require

# Redis — Upstash console → your database → Details. Use the TCP endpoint
# (host/port), NOT the REST URL — this app talks the Redis protocol via
# ioredis, not Upstash's HTTP API.
REDIS_HOST=<endpoint>.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=<password from the same page>
REDIS_TLS=true

# Kafka — Upstash console → your Kafka cluster → Details, "Credentials" tab.
# Real Kafka wire protocol (SASL_SSL) — kafkajs needs no special handling.
KAFKA_BROKERS=<endpoint>.upstash.io:9092
KAFKA_SSL=true
KAFKA_SASL_USERNAME=<username from the Credentials tab>
KAFKA_SASL_PASSWORD=<password from the Credentials tab>
# Upstash Kafka requires topics to exist before use (allowAutoTopicCreation is
# already false in kafka.config.ts) — create these seven in the console first:
# notification-events, notification-critical, notification-routing,
# notification-delivery, notification-status, notification-analytics, notification-dlq

# RabbitMQ — CloudAMQP console → your instance → AMQP URL (starts amqps://,
# already includes credentials and the vhost). Paste it whole.
RABBITMQ_URL=amqps://<user>:<password>@<host>.cloudamqp.com/<vhost>

# Runs `prisma migrate deploy` once before the app starts (see
# docker/entrypoint.sh) — Render has no equivalent to Compose's one-shot
# `migrate` service. Set this on Render only; never set it in local .env.
RUN_MIGRATIONS_ON_BOOT=true

# CORS — your Vercel frontend's actual URL(s), comma-separated, no trailing slash.
CORS_ORIGINS=https://your-frontend.vercel.app
